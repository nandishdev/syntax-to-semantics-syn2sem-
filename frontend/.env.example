# Optional Cloud AI API Keys for Translation
# Supported providers: Gemini, Groq, OpenAI, Anthropic, OpenRouter

# Google Gemini (Free & High Quality)
GEMINI_API_KEY=

# Groq (Ultra-fast inference with Llama 3.3)
GROQ_API_KEY=

# OpenAI (GPT-4o / GPT-4o-mini)
OPENAI_API_KEY=

# Anthropic Claude
ANTHROPIC_API_KEY=

# OpenRouter
OPENROUTER_API_KEY=

# Optional Default Provider (gemini | groq | openai | anthropic | openrouter)
AI_PROVIDER=gemini

