{
  "version": 2,
  "builds": [
    {
      "src": "frontend/server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "frontend/index.html",
          "frontend/styles.css",
          "frontend/script.js",
          "frontend/compiler/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "frontend/server.js"
    }
  ]
}
